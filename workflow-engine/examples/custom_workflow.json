{
  "name": "Custom Steps Showcase",
  "description": "Uses two custom step types registered via --plugin: shout and summarize_json.",
  "version": "1.0.0",
  "variables": {
    "message": "flowforge is extensible!"
  },
  "steps": [
    {
      "id": "announce",
      "type": "shout",
      "name": "Announce loudly",
      "message": "{{ variables.message }}"
    },
    {
      "id": "inspect",
      "type": "summarize_json",
      "name": "Summarize a workflow file",
      "path": "examples/deploy_workflow.json",
      "depends_on": ["announce"]
    },
    {
      "id": "report",
      "type": "http",
      "name": "Report custom step output",
      "method": "POST",
      "url": "http://127.0.0.1:8001/api/notify",
      "body": {
        "message": "Custom step output: '{{ steps.announce.output.message }}' - workflow has keys: {{ steps.inspect.output.top_level_keys }}"
      },
      "depends_on": ["inspect"]
    }
  ]
}